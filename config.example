# KMarkdownify Configuration File
# This file should be copied to ~/.config/kmarkdownify/config
# and customized according to your needs.

# OpenRouter API Model (Fallback/Default)
# This model is used when OCR_MODEL or REASONING_MODEL are not specified
# Default: mistralai/pixtral-large-latest (optimized for OCR)
MODEL=mistralai/pixtral-large-latest

# OCR Model (for Convert Mode)
# Optimized for fast and accurate OCR/document conversion tasks
# This model is used when running kmarkdownify without --solve flag
# Examples:
#   - google/gemini-2.0-flash-lite (fast and cheap)
#   - mistralai/pixtral-large-latest (high quality, balanced)
#   - anthropic/claude-3-opus (premium quality)
# OCR_MODEL=google/gemini-2.0-flash-lite

# Reasoning Model (for Solve Mode) 
# Optimized for problem-solving and reasoning tasks
# This model is used when running kmarkdownify with --solve flag
# Examples:
#   - openai/gpt-4o-mini (good balance of speed and quality)
#   - anthropic/claude-3.5-sonnet (excellent reasoning)
#   - deepseek/deepseek-r1 (specialized reasoning model)
# REASONING_MODEL=openai/gpt-4o-mini

# API Temperature (0.0-1.0)
# Lower values = more deterministic/consistent output
# Higher values = more creative interpretation
# Default: 0.1 (recommended for OCR tasks)
TEMPERATURE=0.1

# Maximum tokens per page for response
# The total tokens will be calculated as: MAX_TOKENS_PER_PAGE * number_of_pages
# This ensures adequate token budget regardless of document length
# Default: 8000 per page (approximately 6000 words per page)
# - For transcribe/convert mode: ~2 pages worth of content per page
# - For solve mode: ~2/3 page worth of content per page (due to solutions)
MAX_TOKENS_PER_PAGE=8000

# Timeout per page in seconds
# The total timeout will be calculated as: TIMEOUT_PER_PAGE * number_of_pages
# This is especially important for reasoning models that may take longer
# Default: 60 seconds per page (1 minute per page)
# - Single page PDFs: 60 seconds timeout
# - 5 page PDFs: 300 seconds (5 minutes) timeout
# - 10 page PDFs: 600 seconds (10 minutes) timeout
# Increase this value if using models that require more processing time
TIMEOUT_PER_PAGE=60

# Enable metadata extraction
# When enabled, the system will attempt to extract document metadata
# (Title, Author, Course, Due Date) and format it as YAML frontmatter
# Default: true
EXTRACT_METADATA=true

# System prompt file path (optional)
# Path to a file containing the system prompt to use
# If not set, uses the built-in prompts based on EXTRACT_METADATA setting
# Can be absolute path or relative to ~/.config/kmarkdownify/
# Example: SYSTEM_PROMPT_FILE="/path/to/custom_prompt.txt"
# SYSTEM_PROMPT_FILE=

# Custom conversion prompt (optional, inline)
# If not set and SYSTEM_PROMPT_FILE is not set, uses the default prompt
# Uncomment and customize to override the default behavior:
# CUSTOM_PROMPT="Your custom prompt here..."

# Metadata fields to extract (comma-separated)
# Default: Title,Author,Course,Due Date
# Add more fields as needed: "Title,Author,Course,Due Date,Student ID,Professor"
METADATA_FIELDS="Title,Author,Course,Due Date"
